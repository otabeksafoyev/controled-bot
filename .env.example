# Telegram userbot credentials — https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# StringSession yaratish: `python scripts/create_session.py` ni ishlating.
# Chiqqan natijani shu yerga yozing.
TELEGRAM_STRING_SESSION=

# Control bot tokeni — yangi bot @BotFather dan (masalan: 123456:ABC-DEF...)
CONTROL_BOT_TOKEN=

# Sizning Telegram IDingiz (masalan: 8173188671).
# Faqat shu foydalanuvchi komandalar chaqira oladi va faqat shu ID dan kelgan
# private video'lar qayta ishlanadi.
OWNER_ID=

# Kaworai_bot bilan bir xil PostgreSQL (masalan:
# postgresql+asyncpg://user:pass@host:5432/kaworai)
DB_URL=

# Minimal video davomiyligi (sekund) — buning tagida bo'lganlar e'tiborga olinmaydi.
MIN_VIDEO_DURATION=60

# Default: unique_id bo'yicha topilmasa, nomi+qism raqami bo'yicha moslashtirsinmi.
# (Odatda bir kanal bir animega bog'langanda kerak emas.)
ENABLE_NAME_FALLBACK=true

# Logging
LOG_LEVEL=INFO
