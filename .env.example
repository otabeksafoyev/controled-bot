# Telegram userbot credentials — https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# StringSession yaratish: `python scripts/create_session.py` ni ishlating.
# Chiqqan natijani shu yerga yozing. (Bo'sh qoldirsangiz birinchi ishga tushganda
# fayl asosidagi sessiya (user.session) yaratiladi — lekin bu interaktiv kod
# so'raydi, shuning uchun server deploy uchun StringSession afzal.)
TELEGRAM_STRING_SESSION=

# Control bot tokeni — yangi bot @BotFather dan
CONTROL_BOT_TOKEN=

# Owner Telegram ID (siz) — faqat shu foydalanuvchi /link /subscribe kabi
# komandalarni chaqira oladi.
OWNER_ID=

# Ingest kanal IDsi (masalan, -1001234567890).
# Ushbu kanalga control bot ADMIN qilib qo'yilgan bo'lishi kerak.
# Userbot yangi kontentni shu yerga forward qiladi, control bot esa forward
# kelganda bot-API file_id ni olib DB ga yozadi.
INGEST_CHANNEL_ID=

# Kaworai_bot bilan bir xil PostgreSQL (masalan:
# postgresql+asyncpg://user:pass@host:5432/kaworai)
DB_URL=

# Minimal video davomiyligi (sekund) — buning tagida bo'lganlar e'tiborga olinmaydi.
MIN_VIDEO_DURATION=60

# Default: unique_id bo'yicha topilmasa, nomi+qism raqami bo'yicha moslashtirsinmi
ENABLE_NAME_FALLBACK=true

# Logging
LOG_LEVEL=INFO
